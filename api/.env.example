PORT=4000
# Comma-separated browser origins allowed to call the API. Set your production frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow only stream hostnames you are authorized to proxy.
STREAM_PROXY_ALLOWED_HOSTS=your-authorized-stream-host.example
CACHE_ENABLED=false
DEFAULT_REDIS_TTL=900
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
